# Server Configuration
PORT=5000
NODE_ENV=development
TRUST_PROXY=false
RENDER_EXTERNAL_URL=https://your-backend-name.onrender.com
APP_TIMEZONE=Asia/Kolkata

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_password
DB_NAME=satyacollection
DB_POOL_SIZE=10

# Security / JWT Configuration
# Important: Ensure JWT_SECRET is a long, complex random string (e.g. 64-character hexadecimal)
JWT_SECRET=replace_with_a_secure_long_random_hex_string
JWT_EXPIRE=15m

# CORS Configuration
# Comma-separated list of allowed domains
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
